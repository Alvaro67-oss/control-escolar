# Copia este archivo como .env y reemplaza los valores.
# .env (con las contraseñas reales) nunca se sube a git.

MYSQL_ROOT_PASSWORD=cambia-esto-por-algo-largo
MYSQL_DATABASE=control_escolar
MYSQL_USER=appuser
MYSQL_PASSWORD=otra-contraseña-fuerte

# Token del túnel de Cloudflare (Zero Trust -> Networks -> Tunnels).
# Déjalo vacío si todavía no configuras el túnel.
CLOUDFLARE_TUNNEL_TOKEN=
